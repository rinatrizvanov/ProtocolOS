# Variable names only. ProtocolOS reads PROTOCOLOS_<NAME> first, then the legacy TRIALLENS_<NAME>
# (trialforge/settings.py).
# Copy to .env (gitignored) for local runs; on Railway set them as service variables.
# Never commit values.

# public-demo guard (trialforge/demo_guard.py): 1 on the deployed app
PROTOCOLOS_PUBLIC=
# 1 re-enables model endpoints on the public app; only with a budgeted router key
PROTOCOLOS_ALLOW_MODEL=

# Chalk Model Gateway (trialforge/llm.py); the key and its environment id go together
CHALK_ROUTER_API_KEY=
CHALK_ROUTER_ENV_ID=
CHALK_ROUTER_MODEL=

# direct Anthropic fallback (trialforge/llm.py)
ANTHROPIC_API_KEY=

# Chalk client credentials for the registry profile chip (trialforge/chalk_bridge.py -> ChalkClient);
# without them the chip says "unavailable"
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=
CHALK_API_SERVER=
