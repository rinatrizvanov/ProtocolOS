# Variable names only. ProtocolOS reads PROTOCOLOS_<NAME> first, then the legacy TRIALLENS_<NAME>
# (trialforge/settings.py).
# Copy to .env (gitignored) for local runs; on Railway set them as service variables.
# Never commit values.

# public-demo guard (trialforge/demo_guard.py): 1 on the deployed app. When it is 1 the server never uses a key of
# its own: model features, new trials and new draft ideas need the visitor's OpenAI or Anthropic key.
PROTOCOLOS_PUBLIC=

# limits on the public app; defaults and meaning in trialforge/access.py
PROTOCOLOS_NEW_PER_HOUR=
PROTOCOLOS_NEW_PER_DAY=
PROTOCOLOS_MODEL_PER_HOUR=
PROTOCOLOS_CHECKS_PER_HOUR=
PROTOCOLOS_MIN_FREE_MB=

# local runs only (ignored when PROTOCOLOS_PUBLIC=1): a key for model mode and `evals.run_evals --llm`
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
