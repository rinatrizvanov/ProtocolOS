# .gitignore compatible file for ignoring files with chalk apply
# Chalk also respects .gitignore

# Ignore test files
tests

# Python artifacts
venv
*venv*
virtualenv
__pycache__
*.pyc
*.py~
.eggs
*.egg-info
dist
*.ipynb_checkpoints*

# Editor configuration
.vscode
.zed
.helix

# Intellij
*.iml
idea

# Git artifacts
.git
.github

# ProtocolOS app code, data and docs are not part of the Chalk feature deployment
trialforge/
web/
evals/
data/
research/
tests/
Regeneron starter-kit/
chalk_project/*.py
chalk_project/*.jsonl
chalk_project/feature_store/chalk.yaml
